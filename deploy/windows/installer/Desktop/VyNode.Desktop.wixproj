<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputName>VyNode-Desktop-unsigned</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PackageVersion Condition="'$(PackageVersion)' == ''">16.0.0</PackageVersion>
    <DefineConstants>ClientPublish=$(ClientPublish);PackageVersion=$(PackageVersion)</DefineConstants>
    <AcceptEula>wix7</AcceptEula>
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>
</Project>
