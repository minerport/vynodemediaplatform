<Application x:Class="VyNode.ServerManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0C0E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#17191D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F4A340" />
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="#F7F7F8" />
      <Setter Property="BorderBrush" Value="#34373D" />
    </Style>
  </Application.Resources>
</Application>
