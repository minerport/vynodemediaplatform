<Window x:Class="VyNode.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VyNode Server Manager" Width="760" Height="540" MinWidth="680" MinHeight="480"
        Background="{StaticResource BackgroundBrush}" Foreground="#F7F7F8" WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="VyNode Media Server" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="Local service management" Foreground="#A7A9AE" FontSize="15" Margin="0,4,0,24" />
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="22" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Installation" Foreground="#A7A9AE" Margin="0,5"/><TextBlock x:Name="InstalledText" Grid.Column="1" Margin="0,5" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Service" Foreground="#A7A9AE" Margin="0,5"/><TextBlock x:Name="ServiceText" Grid.Row="1" Grid.Column="1" Margin="0,5" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="2" Text="Version" Foreground="#A7A9AE" Margin="0,5"/><TextBlock x:Name="VersionText" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
        <TextBlock Grid.Row="3" Text="Data and logs" Foreground="#A7A9AE" Margin="0,5"/><TextBlock x:Name="PathText" Grid.Row="3" Grid.Column="1" Margin="0,5" TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2">
      <WrapPanel>
        <Button x:Name="StartButton" Content="Start" Click="Start_Click" AutomationProperties.Name="Start VyNode Media Server"/>
        <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" AutomationProperties.Name="Stop VyNode Media Server"/>
        <Button x:Name="RestartButton" Content="Restart" Click="Restart_Click" AutomationProperties.Name="Restart VyNode Media Server"/>
        <Button Content="Refresh" Click="Refresh_Click"/>
      </WrapPanel>
      <WrapPanel Margin="0,8,0,0">
        <Button Background="{StaticResource AccentBrush}" Foreground="#17120B" BorderBrush="{StaticResource AccentBrush}" Content="Open Web Admin" Click="OpenAdmin_Click"/>
        <Button Content="Open Data Folder" Click="OpenData_Click"/>
        <Button Content="Open Logs Folder" Click="OpenLogs_Click"/>
      </WrapPanel>
      <TextBlock x:Name="MessageText" Foreground="#FFD08A" Margin="0,18,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock Grid.Row="3" Text="Service changes use Windows Service Control Manager and may request administrator approval." Foreground="#777A81" FontSize="12"/>
  </Grid>
</Window>
