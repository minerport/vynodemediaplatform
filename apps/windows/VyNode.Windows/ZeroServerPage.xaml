<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VyNode.Windows.ZeroServerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource VyBackground}">
    <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
      <TextBlock Text="Your VyNode account is ready" Style="{StaticResource TitleTextBlockStyle}" Foreground="{StaticResource VyText}" TextWrapping="Wrap" />
      <TextBlock Text="No media servers are linked yet. Link a server or accept an invitation, then refresh." Foreground="{StaticResource VyMuted}" TextWrapping="Wrap" />
      <Button Content="Refresh Linked Servers" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Refresh_Click" />
      <Button Content="Connect Manually" HorizontalAlignment="Left" Click="Manual_Click" />
      <Button Content="Sign Out" HorizontalAlignment="Left" Click="SignOut_Click" />
      <TextBlock x:Name="StatusText" Foreground="{StaticResource VyMuted}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
