<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="VyNode.Windows.SignInPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource VyBackground}">
    <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
      <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource VyAccent}" HorizontalAlignment="Left">
        <TextBlock Text="V" Foreground="#FF241306" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="Sign in to VyNode" Style="{StaticResource TitleTextBlockStyle}" Foreground="{StaticResource VyText}" Margin="0,8,0,0" />
      <TextBlock Text="Your linked media servers will appear automatically." Foreground="{StaticResource VyMuted}" TextWrapping="Wrap" />
      <TextBox x:Name="UsernameBox" Header="Username" AutomationProperties.Name="VyNode username" />
      <PasswordBox x:Name="PasswordBox" Header="Password" AutomationProperties.Name="VyNode password" />
      <TextBlock x:Name="ErrorText" Foreground="#FFFF786C" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
      <Button x:Name="SignInButton" Content="Sign In" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="SignIn_Click" />
      <Button Content="Create Account" HorizontalAlignment="Stretch" Click="CreateAccount_Click" />
      <Button Content="Advanced" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource VyMuted}" Click="Advanced_Click" />
    </StackPanel>
  </Grid>
</Page>
